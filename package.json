{
  "name": "mtb-release-action",
  "version": "0.0.0",
  "author": "Wesley",
  "type": "module",
  "private": true,
  "keywords": [
    "actions"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm format:write && pnpm package",
    "format:write": "pnpm dlx prettier --write .",
    "format:check": "pnpm dlx prettier --check .",
    "lint": "pnpm dlx eslint .",
    "lint:fix": "pnpm dlx eslint --fix .",
    "package": "tsdown"
  },
  "packageManager": "pnpm@8.6.5",
  "dependencies": {
    "@actions/cache": "^4.0.3",
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "@octokit/rest": "^19.0.5",
    "glob": "^10.3.10"
  },
  "devDependencies": {
    "@actions/github": "^6.0.1",
    "@eslint/compat": "^1.3.1",
    "@types/node": "^24.0.12",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.1",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "prettier-eslint": "^16.4.2",
    "tsdown": "^0.12.9",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}
